<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainMenuAdmin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_gradiente_principal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Regresar"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_black"
            app:tint="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel Administrador"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/btnVolver"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/fondo_info_album"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestión de Usuarios"
                    android:textColor="#ABFFBD"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buscar usuario para editar o eliminar:"
                    android:textColor="#B0B0B0"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etBusquedaUsuarios"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/fondo_input_login"
                        android:hint="Nombre de usuario..."
                        android:textColorHint="#B0B0B0"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"/>

                    <ImageButton
                        android:id="@+id/btnBuscarUsuarios"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/fondo_boton_principal"
                        android:src="@drawable/ic_search"
                        android:scaleType="centerInside"
                        android:padding="12dp"
                        app:tint="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/fondo_info_album"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvTituloMenuAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Herramientas del Sistema"
                    android:textColor="#ABFFBD"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvDescripcionAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configuraciones globales y reportes"
                    android:textColor="#B0B0B0"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp"/>

                <Button
                    android:id="@+id/btnCategoriasMusicales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Categorías Musicales"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:background="@drawable/fondo_boton_secundario"
                    app:backgroundTint="@null"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnReportes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ver Reportes"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:background="@drawable/fondo_boton_secundario"
                    app:backgroundTint="@null"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnAdministrarUsuarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Administrar Usuarios"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/fondo_boton_principal"
                    app:backgroundTint="@null"
                    android:paddingVertical="12dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>