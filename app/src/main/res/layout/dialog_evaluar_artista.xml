<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#333333"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valorar Artista"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toca las estrellas para calificar"
            android:textColor="#ABFFBD"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutEstrellas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etComentario"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/fondo_input_area"
            android:hint="Escribe tu opinión (opcional)..."
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            android:padding="16dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:maxLength="300"
            android:maxLines="5"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:textColor="#B80000"
                android:textStyle="bold"
                android:background="@drawable/fondo_boton_negativo"
                app:backgroundTint="@null"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnEnviar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Enviar"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/fondo_boton_principal"
                app:backgroundTint="@null"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
